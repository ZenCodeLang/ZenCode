FILE
  DEF_CLASS
    K_CLASS "class"
    T_WHITESPACE " "
    NAME
      T_IDENTIFIER "Foo"
    T_WHITESPACE " "
    MEMBERS
      T_AOPEN "{"
      T_WHITESPACE "\n	"
      MEMB_METHOD
        NAME
          T_IDENTIFIER "bar"
        FUNCTION_HEADER
          PARAM_LIST
            T_BROPEN "("
            T_BRCLOSE ")"
          T_WHITESPACE " "
        BLOCK
          T_AOPEN "{"
          T_ACLOSE "}"
        T_WHITESPACE "\n	"
      MEMB_METHOD
        MODIFIERS
          K_ABSTRACT "abstract"
          T_WHITESPACE " "
        NAME
          T_IDENTIFIER "baz"
        FUNCTION_HEADER
          PARAM_LIST
            T_BROPEN "("
            T_BRCLOSE ")"
        T_SEMICOLON ";"
        T_WHITESPACE "\n"
      T_ACLOSE "}"
