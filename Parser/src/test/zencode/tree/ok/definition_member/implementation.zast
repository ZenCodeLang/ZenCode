FILE
  DEF_CLASS
    K_CLASS "class"
    T_WHITESPACE " "
    NAME
      T_IDENTIFIER "Foo"
    T_WHITESPACE " "
    MEMBERS
      T_AOPEN "{"
      T_WHITESPACE "\n	"
      MEMB_IMPLEMENTS
        K_IMPLEMENTS "implements"
        T_WHITESPACE " "
        TYPE_NAMED
          NAME
            T_IDENTIFIER "Bar"
        T_SEMICOLON ";"
      T_WHITESPACE "\n	"
      MEMB_IMPLEMENTS
        K_IMPLEMENTS "implements"
        T_WHITESPACE " "
        TYPE_NAMED
          NAME
            T_IDENTIFIER "Baz"
          T_WHITESPACE " "
        T_AOPEN "{"
        T_ACLOSE "}"
      T_WHITESPACE "\n"
      T_ACLOSE "}"
