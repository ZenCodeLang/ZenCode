FILE
  DEF_CLASS
    K_CLASS "class"
    T_WHITESPACE_SPACE " "
    NAME
      T_IDENTIFIER "Foo"
    T_WHITESPACE_SPACE " "
    MEMBERS
      T_AOPEN "{"
      T_WHITESPACE_NEWLINE "\n"
      T_WHITESPACE_TAB "	"
      MEMB_IMPLEMENTS
        K_IMPLEMENTS "implements"
        T_WHITESPACE_SPACE " "
        TYPE
          NAME
            T_IDENTIFIER "Bar"
        T_SEMICOLON ";"
      T_WHITESPACE_NEWLINE "\n"
      T_WHITESPACE_TAB "	"
      MEMB_IMPLEMENTS
        K_IMPLEMENTS "implements"
        T_WHITESPACE_SPACE " "
        TYPE
          NAME
            T_IDENTIFIER "Baz"
          T_WHITESPACE_SPACE " "
        T_AOPEN "{"
        T_ACLOSE "}"
      T_WHITESPACE_NEWLINE "\n"
      T_ACLOSE "}"
