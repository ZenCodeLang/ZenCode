FILE
  DEF_VARIANT
    K_VARIANT "variant"
    T_WHITESPACE " "
    NAME
      T_IDENTIFIER "Foo"
    TYPE_PARAMS
      T_LESS "<"
      TYPE_PARAM
        NAME
          T_IDENTIFIER "T"
      T_GREATER ">"
      T_WHITESPACE " "
    MEMBERS
      T_AOPEN "{"
      T_WHITESPACE "\n	"
      VARIANT_OPTION
        NAME
          T_IDENTIFIER "A"
        VARIANT_OPTION_TYPES
          T_BROPEN "("
          TYPE
            NAME
              T_IDENTIFIER "T"
          T_BRCLOSE ")"
      T_COMMA ","
      T_WHITESPACE "\n	"
      VARIANT_OPTION
        NAME
          T_IDENTIFIER "B"
        T_WHITESPACE "\n"
      T_ACLOSE "}"
