FILE
  DEF_CLASS
    K_CLASS "class"
    T_WHITESPACE_SPACE " "
    NAME
      T_IDENTIFIER "Foo"
    T_WHITESPACE_SPACE " "
    MEMBERS
      T_AOPEN "{"
      T_WHITESPACE_NEWLINE "\n"
      T_WHITESPACE_TAB "	"
      MEMB_DESTRUCTOR
        T_CAT "~"
        K_THIS "this"
        T_WHITESPACE_SPACE " "
        BLOCK
          T_AOPEN "{"
          T_ACLOSE "}"
        T_WHITESPACE_NEWLINE "\n"
      T_ACLOSE "}"
